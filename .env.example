# ---------------------------------------------------------------------------
# Quiz de Carreiras Nicopel — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione o .env.local.
# ---------------------------------------------------------------------------

# Postgres gerenciado (Neon, Supabase ou outro provedor do Marketplace da Vercel).
# Sem esta variável o quiz funciona normalmente; apenas a inscrição no sorteio
# fica indisponível e o usuário recebe uma mensagem amigável.
DATABASE_URL=

# Hash da senha do painel /admin.
# Gere com: npm run admin:hash -- "sua-senha-forte"
# Formato: scrypt$<salt-hex>$<hash-hex>
ADMIN_PASSWORD_HASH=

# Segredo usado para assinar o cookie de sessão do admin (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# URL pública final (usada em metadados Open Graph e no link de compartilhamento).
# Ex.: https://quiz.nicopel.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data limite de retenção dos dados do sorteio (ISO 8601, ex.: 2026-11-13).
# Exibida na página /privacidade e usada no checklist de exclusão.
DATA_RETENTION_DATE=

# Habilita a rota de verificação técnica /status fora de desenvolvimento.
# Deixe vazio em produção para manter a rota desativada.
STATUS_PAGE_TOKEN=
